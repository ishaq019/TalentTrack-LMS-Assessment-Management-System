# MongoDB Connection
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/talenttrack?retryWrites=true&w=majority

# JWT Secrets
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars

# Server Configuration
PORT=8080
NODE_ENV=production

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email Sender Details
EMAIL_FROM=TalentTrack <noreply@talenttrack.com>

# Frontend URL (for CORS and email links)
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Optional: Disable cron jobs on Vercel (recommended)
JOBS_ENABLED=false

# Default Admin Account (auto-seeded on startup / Vercel cold start)
# - If unset, no admin will be created automatically and admin login will fail.
# - If set, the user is created (or existing user is promoted) on every cold start;
#   the password hash is re-synced to ADMIN_PASSWORD so login is guaranteed to work.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe!Strong#2025
ADMIN_NAME=TalentTrack Admin

# Vercel Detection (automatically set by Vercel)
# VERCEL=1
